{
  "name": "@qnxg-recruit/root",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "description": "qnxg 招新招聘系统 — pnpm monorepo 全栈工程",
  "author": "Twisuki",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @qnxg-recruit/web run dev",
    "dev:server": "pnpm --filter @qnxg-recruit/server run dev",
    "build": "pnpm --filter @qnxg-recruit/server run build && pnpm --filter @qnxg-recruit/web run build",
    "check": "pnpm -r run check",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "eslint": "^9.18.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "husky": "^9.1.7",
    "typescript": "^5.7.3"
  }
}
